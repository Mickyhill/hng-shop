# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the site (no trailing slash). Used for auth redirects and email links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email provider: "brevo" (default, free plan without a card) or "mailgun"
EMAIL_PROVIDER=brevo

# Brevo: SMTP & API > API Keys, and Senders (verify the sender email first)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME="MickyHill Store"

# Mailgun (only if EMAIL_PROVIDER=mailgun): Sending > Domains, and API Keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Use https://api.eu.mailgun.net if your Mailgun account is in the EU region
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_FROM=
